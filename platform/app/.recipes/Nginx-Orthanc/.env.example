# ==============================================================================
# Sprint Diagnostics PACS Environment Configuration (.env)
# Copy this file to .env in this directory (platform/app/.recipes/Nginx-Orthanc/.env):
#   cp .env.example .env
# ==============================================================================

# MySQL Database Password (matches orthanc database password)
MYSQL_PASSWORD=orthanc_password

# AWS Credentials for S3 Bucket (all-restic)
# If using EC2 IAM Instance Profile, these can be left empty
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Keycloak / OAuth2-Proxy Credentials
# Client ID is: prd-pacs-sprint
OAUTH2_PROXY_CLIENT_SECRET=your_keycloak_client_secret_here

# 16, 24, or 32 bytes base64 encoded secret for cookie encryption
# Generate one using: python3 -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
# Or: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=your_cookie_secret_here

# (Optional) Custom Let's Encrypt / Certbot directory overrides
# LETSENCRYPT_DIR=./config/letsencrypt
# CERTBOT_WEBROOT=./config/certbot
